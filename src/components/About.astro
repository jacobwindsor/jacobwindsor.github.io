---
import { Card, CardContent } from "@/components/ui/card";
import { Code2, Database, GitBranch, TrendingUp } from "lucide-react";
import paragliding from "./images/paragliding.webp";
import paraglidingJpg from "./images/paragliding.jpg";
---

<section id="about" class="py-20 px-6 lg:px-8 bg-background">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16">
      <h2
        class="text-4xl lg:text-5xl font-semibold mb-4 text-foreground tracking-tight"
      >
        About
      </h2>
      <div class="w-12 h-px bg-primary mx-auto mb-6"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-5">
        <p class="leading-relaxed font-light">
          I work at the intersection of science, software, AI, and engineering - 
          helping research organizations transform how they build and adopt technology
          to accelerate scientific discovery.
        </p>
        <p class="leading-relaxed font-light">
          I am a firm believer that software can and should enale great science, 
          not be a bottleneck. Through a well-reasoned and architected approach, 
          engineering & IT can become the quiet enabler of progress, rather than an
          onstacle to it.
        </p>
        <p class="leading-relaxed font-light">
          With a background in biology and bioinformatics, and full-stack software engineering,
          I turn complex challenges into scalable solutions. I've build data platforms processing
          petabytes of genomic data, developed tools used by researchers worldwide, and led 
          multidisciplinary teams to deliver technology across research organizations.
        </p>
        <p class="leading-relaxed font-light">
          Outside of work, I'm passionate about mountain sports.
        </p>
      </div>

      <div
        class="relative rounded-md overflow-hidden border border-border/50 bg-card"
      >
        <picture>
          <source srcset={paragliding.src} type="image/webp" />
          <img
            src={paraglidingJpg.src}
            alt="Paragliding"
            class="w-full h-auto object-cover"
          />
        </picture>
      </div>
    </div>
  </div>
</section>
